					"slug": "surface-lowest"
				}
			]
		},
		"custom": {
			"letterSpacing": {
				"tight": "-0.02em",
				"tighter": "-0.04em",
				"wide": "0.1em",
				"wider": "0.25em",
				"widest": "0.35em"
			}
		},
		"layout": {
			"contentSize": "780px",
			"wideSize": "1240px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "2XS",
					"size": "0.5rem",
					"slug": "20"
				},
				{
					"name": "XS",
					"size": "1rem",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "1.5rem",
					"slug": "40"
				},
				{
					"name": "Medium",
					"size": "2rem",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(2rem, 4vw, 3rem)",
					"slug": "60"
				},
				{
					"name": "XL",
					"size": "clamp(3rem, 6vw, 5rem)",
					"slug": "70"
				},
				{
					"name": "2XL",
					"size": "clamp(5rem, 9vw, 8rem)",
