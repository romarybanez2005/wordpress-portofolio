				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"src": [
								"file:./assets/fonts/Space_Grotesk/SpaceGrotesk-VariableFont_wght.ttf"
							]
						}
					],
					"fontFamily": "'Space Grotesk', sans-serif",
					"name": "Space Grotesk",
					"slug": "headline"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/Inter/Inter-VariableFont_opsz,wght.ttf"
							]
						},
						{
							"fontFamily": "Inter",
							"fontStretch": "normal",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/Inter/Inter-Italic-VariableFont_opsz,wght.ttf"
							]
						}
					],
					"fontFamily": "'Inter', sans-serif",
					"name": "Inter",
					"slug": "body"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Playfair Display",
							"fontStretch": "normal",
							"fontStyle": "italic",
							"fontWeight": "400 900",
							"src": [
								"file:./assets/fonts/Playfair_Display/PlayfairDisplay-Italic-VariableFont_wght.ttf"
							]
						},
						{
							"fontFamily": "Playfair Display",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"src": [
								"file:./assets/fonts/Playfair_Display/PlayfairDisplay-VariableFont_wght.ttf"
							]
						}
					],
					"fontFamily": "'Playfair Display', serif",
					"name": "Playfair Display",
					"slug": "accent"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Label",
					"size": "0.75rem",
					"slug": "label"
				},
				{
					"fluid": false,
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.125rem",
						"min": "1rem"
					},
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.25rem",
						"min": "1.125rem"
					},
					"name": "Large",
					"size": "1.25rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2.5rem",
						"min": "1.5rem"
					},
					"name": "XL",
					"size": "2rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "4rem",
						"min": "2.25rem"
					},
					"name": "2XL",
					"size": "3rem",
					"slug": "xx-large"
				},
				{
					"fluid": {
						"max": "6.75rem",
						"min": "3rem"
					},
					"name": "Display",
					"size": "5rem",
					"slug": "display"
				},
				{
					"fluid": {
						"max": "10rem",
						"min": "4rem"
					},
					"name": "Hero",
					"size": "8rem",
					"slug": "hero"
				},
				{
					"fluid": {
						"max": "6.75rem",
						"min": "3rem"
					},
					"name": "Mega",
					"size": "5rem",
					"slug": "mega"
				}
			],
			"writingMode": true
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/button": {
				"border": {
					"radius": "0px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"letterSpacing": "0.25em",
					"textTransform": "uppercase"
				},
				"variations": {
					"outline": {
						"border": {
							"color": "var(--wp--preset--color--on-surface)",
							"width": "1px"
						},
						"color": {
							"text": "var(--wp--preset--color--on-surface)"
						},
						"spacing": {
							"padding": {
								"bottom": "calc(1rem - 1px)",
								"left": "calc(2.25rem - 1px)",
								"right": "calc(2.25rem - 1px)",
								"top": "calc(1rem - 1px)"
							}
						},
						":hover": {
							"color": {
								"background": "var(--wp--preset--color--on-surface)",
								"text": "var(--wp--preset--color--surface)"
							}
						}
					}
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--50)"
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"color": "var(--wp--preset--color--outline-variant)",
						"style": "solid",
						"width": "1px"
					}
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)"
					}
				},
				"css": "& summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:1.5rem;align-items:baseline;font-family:var(--wp--preset--font-family--headline);font-size:var(--wp--preset--font-size--large);font-weight:700;letter-spacing:-0.01em;line-height:1.25;text-transform:uppercase;color:var(--wp--preset--color--on-surface)} & summary::-webkit-details-marker{display:none} & summary::after{content:'+';flex:none;font-weight:400;font-size:1.5em;line-height:0.8;color:var(--wp--preset--color--primary);transition:transform .2s ease} &[open] summary::after{transform:rotate(45deg)} & summary:hover{color:var(--wp--preset--color--primary)} & > :not(summary){margin-top:var(--wp--preset--spacing--30);color:var(--wp--preset--color--on-surface-variant);max-width:62ch}"
			},
			"core/image": {
				"border": {
					"radius": "0px"
				}
			},
			"core/navigation": {
				"color": {
					"text": "var(--wp--preset--color--on-surface-variant)"
				},
				"elements": {
					"link": {
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							}
						},
						"color": {
							"text": "var(--wp--preset--color--on-surface-variant)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "0.8125rem",
					"fontWeight": "500",
					"letterSpacing": "0.2em",
					"textTransform": "uppercase"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--on-surface-variant)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0.15em",
					"textTransform": "uppercase"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"fontWeight": "700",
					"letterSpacing": "0.2em",
					"textTransform": "uppercase"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--primary)",
					"style": "solid",
					"width": "0 0 0 3px"
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--40)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--accent)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontStyle": "italic",
					"lineHeight": "1.4"
				}
			},
			"core/search": {
				"css": "& .wp-block-search__input{border-radius:0;border-color:var(--wp--preset--color--outline-variant);background:transparent;color:var(--wp--preset--color--on-surface);}",
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"core/separator": {
				"border": {
					"color": "var(--wp--preset--color--outline-variant)",
					"style": "solid",
					"width": "0 0 1px 0"
				},
				"color": {
					"text": "var(--wp--preset--color--outline-variant)"
				}
			},
			"core/site-title": {
				"elements": {
					"link": {
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							},
							"typography": {
								"textDecoration": "none"
							}
						},
						"color": {
							"text": "var(--wp--preset--color--on-surface)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "1.5rem",
					"fontWeight": "700",
					"letterSpacing": "0.05em",
					"textTransform": "uppercase"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--surface)",
			"text": "var(--wp--preset--color--on-surface)"
		},
		"elements": {
			"button": {
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--on-surface)",
						"text": "var(--wp--preset--color--surface)"
					}
				},
				"border": {
					"radius": "0px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--surface)"
				},
				"spacing": {
					"padding": {
						"bottom": "1rem",
						"left": "2.25rem",
						"right": "2.25rem",
						"top": "1rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"letterSpacing": "0.25em",
					"textTransform": "uppercase"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--on-surface-variant)"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--20)",
						"bottom": "0"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"fontWeight": "600",
					"letterSpacing": "0.15em",
					"lineHeight": "1.5",
					"textTransform": "uppercase"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--display)",
					"fontWeight": "700",
					"letterSpacing": "-0.03em",
					"lineHeight": "0.95",
					"textTransform": "uppercase"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "1",
					"textTransform": "uppercase"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.05",
					"textTransform": "uppercase"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.2",
					"textTransform": "uppercase"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"letterSpacing": "0",
					"lineHeight": "1.3"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"fontWeight": "700",
					"letterSpacing": "0.25em",
					"lineHeight": "1.4",
					"textTransform": "uppercase"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--on-surface)"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				"color": {
					"text": "currentColor"
				}
			}
		},
		"spacing": {
			"blockGap": "0",
			"padding": {
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)",
				"top": "0"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.65"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}